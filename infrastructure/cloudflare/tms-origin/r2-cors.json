{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://www.saturnusgo.com",
          "https://saturnusgo.com",
          "https://tms.saturnusgo.com",
          "http://localhost:3000"
        ],
        "methods": ["GET", "HEAD", "PUT"],
        "headers": ["Content-Type", "Range", "x-amz-checksum-sha256"]
      },
      "exposeHeaders": [
        "ETag",
        "Content-Length",
        "Content-Range",
        "Accept-Ranges",
        "x-amz-checksum-sha256"
      ],
      "maxAgeSeconds": 3600
    }
  ]
}

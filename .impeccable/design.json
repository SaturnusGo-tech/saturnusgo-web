  "narrative": {
    "northStar": "The Quality Workspace",
    "overview": "Falcon's accepted marketing world pairs a near-black canvas with off-white type, quiet graphite rules and precise Geist typography. Spacious chapters let current product screens explain coverage, execution and connected tools. Original silver isometric illustrations support the story without competing with the product.\n\n**Scope:** this document governs the public marketing direction implemented by `app/src/modules/core-falcon-public/direction/FalconDirection.tsx`, including its embedded demo form. It does not prescribe colors, density, layout or controls for authenticated TMS, authentication, administration or documentation readers. Those surfaces retain their own references and module systems. Product screens shown here are evidence, not a new theme for the application.",
    "keyCharacteristics": [
      "Monochrome contrast and restrained controls.",
      "Large left-aligned headings with compact navigation.",
      "Current product captures, layered with shallow perspective.",
      "Content remains readable when motion is paused or reduced."
    ],
    "rules": [
      {
        "name": "The Product Evidence Rule",
        "body": "Keep the marketing chrome monochrome; preserve meaningful semantic colors inside the actual product captures.",
        "section": "colors"
      },
      {
        "name": "The Evidence Depth Rule",
        "body": "Use elevated framing for product evidence; keep surrounding prose and sections on the continuous canvas.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the current linear Falcon mark, Geist typography and monochrome marketing chrome.",
      "Do use current product captures and original silver illustrations with asset provenance.",
      "Do keep Open app pointed at web login, desktop downloads in the authenticated profile and public Docs readable without sign-in.",
      "Do preserve keyboard focus, marquee pause and reduced-motion behavior."
    ],
    "donts": [
      "Don't apply this marketing token set to authenticated TMS, authentication, administration or documentation-reader interfaces.",
      "Don't replace product evidence with generic SaaS cards or introduce decorative color into the marketing chrome.",
      "Don't make the content depend on animation or invent product capabilities in illustrative screens."
    ]
  }

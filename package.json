{
    "name": "saturnusgo-landing",
    "private": true,
    "version": "1.0.0",
    "scripts": {
        "dev": "next dev -p 3000",
        "build": "next build",
        "export": "next export",
        "build:static": "next build && next export",
        "start": "next start",
        "lint": "echo \"(lint skipped)\"",
        "clean": "rm -rf .next out dist",
        "build:once": "next build",
        "build:standalone": "npm run clean && BUILD_TARGET=standalone npm run build:once && mkdir -p dist/standalone && cp -R .next/standalone dist/standalone && cp -R public dist/standalone/public || true",
        "build:export": "npm run clean && BUILD_TARGET=export npm run build:once && mkdir -p dist/export && cp -R out dist/export",
        "build:dual": "npm run clean && BUILD_TARGET=standalone npm run build:once && mkdir -p dist/standalone && cp -R .next/standalone dist/standalone && cp -R public dist/standalone/public || true && rm -rf .next && BUILD_TARGET=export npm run build:once && mkdir -p dist/export && cp -R out dist/export",
        "postinstall": "patch-package --error-on-fail",
    "deploy:pages": "bash scripts/deploy_pages.sh --publish",
    "prepare:pages": "bash scripts/deploy_pages.sh --prepare",
        "typecheck": "tsc --noEmit",
        "architecture:tms": "node scripts/check-tms-architecture.mjs",
        "test:tms-auth": "tsx --test app/src/core/tms/transport/http.test.ts app/src/modules/core-tms/auth/application/*.test.ts app/src/modules/core-tms/auth/config/*.test.ts app/src/modules/core-tms/auth/navigation/*.test.ts",
        "test:tms-attachments": "tsx --test app/src/modules/core-tms/attachments/tests/*.test.ts",
    "test:tms-adapters": "tsx --test app/src/modules/core-tms/test-cases/tests/*.test.ts app/src/modules/core-tms/test-cases/tests/bulk/*.test.ts app/src/modules/core-tms/test-cases/navigation/*.test.ts app/src/modules/core-tms/test-cases/exchange/tests/*.test.ts app/src/modules/core-tms/runs/tests/*.test.ts app/src/modules/core-tms/runs/tests/recovery/*.test.ts app/src/modules/core-tms/suites/tests/*.test.ts app/src/modules/core-tms/projects/tests/*.test.ts app/src/modules/core-tms/environments/tests/*.test.ts app/src/modules/core-tms/dashboards/tests/*.test.ts app/src/modules/core-tms/external-links/tests/*.test.ts app/src/modules/core-tms/defects/tests/*.test.ts app/src/modules/core-tms/youtrack/tests/*.test.ts app/src/modules/core-tms/application/projects/*.test.ts app/src/modules/core-tms/application/runs/*.test.ts app/src/modules/core-tms/application/suites/*.test.ts app/src/modules/core-tms/application/evidence/*.test.ts app/src/modules/core-tms/presentation/api-testing/tests/*.test.ts app/src/modules/core-tms/presentation/cases/bulk/selection/*.test.ts app/src/modules/core-tms/presentation/cases/inspector/tests/*.test.ts app/src/modules/core-tms/presentation/cases/model/tests/*.test.ts app/src/modules/core-tms/presentation/cases/repository/tests/*.test.ts app/src/modules/core-tms/presentation/dashboard/tests/*.test.ts app/src/modules/core-tms/presentation/runs/tests/*.test.ts app/src/modules/core-tms/presentation/workspace-state/tests/*.test.ts app/src/modules/core-tms/presentation/dialogs/run-builder/*.test.ts app/src/modules/core-tms/state/case-bulk/reconciliation/*.test.ts app/src/modules/core-tms/state/run-builder/*.test.ts app/src/modules/core-tms/state/workspace-derived/tests/*.test.ts",
        "sync:tms-contract": "node scripts/sync-tms-contract.mjs && npm run generate:tms-contract",
        "generate:tms-contract": "openapi-typescript ${TMS_OPENAPI_PATH:-app/src/core/tms/generated/tms-openapi.json} -o app/src/core/tms/generated/tms-api.ts",
        "check:tms-contract": "npm run generate:tms-contract && git diff --exit-code -- app/src/core/tms/generated/tms-api.ts"
    },
    "dependencies": {
        "@auth0/auth0-react": "2.24.1",
        "@formkit/auto-animate": "^0.8.2",
        "@heroui/react": "^2.8.2",
        "@heroui/theme": "^2.4.20",
        "@lottiefiles/react-lottie-player": "^3.6.0",
        "@mdxeditor/editor": "4.2.3",
        "@noble/hashes": "2.4.0",
        "@radix-ui/react-slot": "^1.2.3",
        "@tanstack/react-query": "^5.85.5",
        "@uiw/react-md-editor": "4.1.2",
        "@web3modal/wagmi": "^5.1.11",
        "class-variance-authority": "^0.7.1",
        "embla-carousel-react": "^8.6.0",
        "framer-motion": "^12.23.12",
        "geist": "^1.4.2",
        "leaflet": "^1.9.4",
        "lucide-react": "^0.539.0",
        "motion": "^12.23.12",
        "next": "^14.2.31",
        "next-themes": "^0.4.6",
        "qrcode": "^1.5.4",
        "react": "18.3.1",
        "react-dom": "18.3.1",
        "recharts": "3.10.1",
        "tw-animate-css": "^1.3.7",
        "viem": "^2.34.0",
        "wagmi": "^2.16.5"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.1.12",
        "@types/node": "24.3.0",
        "@types/qrcode": "^1.5.5",
        "@types/react": "19.1.10",
        "@types/react-dom": "^19.1.7",
        "autoprefixer": "^10.4.21",
        "openapi-typescript": "7.13.0",
        "patch-package": "8.0.1",
        "postcss": "^8.5.6",
        "tailwindcss": "^4.1.12",
        "tsx": "4.23.12",
        "typescript": "5.9.2"
    }
}
